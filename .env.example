# .env — PostgreSQL credentials
# Copy this file and fill in your actual values.
# Never commit the filled .env to Git.

PG_HOST=your-db-host.example.com
PG_PORT=5432
PG_DBNAME=your_db_name
PG_USER=your_db_user
PG_PASSWORD=your_db_password

# ── Report store (the "report DB") ─────────────────────────────────
# Where computed reports are WRITTEN by the pipeline and READ by the
# dashboard backend. Set REPORT_BACKEND to "sqlite" or "postgres".
REPORT_BACKEND=sqlite
REPORT_PG_HOST=your-report-db-host.example.com
REPORT_PG_PORT=5432
REPORT_PG_DBNAME=your_report_db_name
REPORT_PG_SCHEMA=public
REPORT_PG_USER=your_report_db_user
REPORT_PG_PASSWORD=your_report_db_password

# ── Credit-bureau engine DB ────────────────────────────────────────
# `cb_engine` is a separate DATABASE on the SAME server as the core
# replica, so host/port/user/password default to the PG_* values above
# and only the dbname differs. Set the rest only if it ever moves hosts.
CB_PG_DBNAME=cb_engine
# CB_PG_HOST=
# CB_PG_PORT=
# CB_PG_USER=
# CB_PG_PASSWORD=

# Shared Ananya Sathi identity database (read-only).
# Host/user/password default to PG_* when omitted.
IDENTITY_PG_DBNAME=Ananya_app_prod
# IDENTITY_PG_HOST=
# IDENTITY_PG_PORT=
# IDENTITY_PG_SCHEMA=public
# IDENTITY_PG_USER=
# IDENTITY_PG_PASSWORD=

# MIS authorization/session database (no passwords are copied here).
# Host/user/password default to REPORT_PG_* and then PG_* when omitted.
MIS_PG_DBNAME=ananya_mis_dashboard
MIS_PG_SCHEMA=public
# MIS_PG_HOST=
# MIS_PG_PORT=
# MIS_PG_USER=
# MIS_PG_PASSWORD=

# Sliding MIS idle timeout. Active API use extends it; inactivity expires it.
SESSION_TIMEOUT_MINUTES=15

# Frontend automatic logout timer; keep equal to SESSION_TIMEOUT_MINUTES.
VITE_SESSION_TIMEOUT_MINUTES=15

# Required only for the first startup when public.mis_users is empty.
# The user must already be active in Ananya Sathi. Remove after bootstrapping.
MIS_BOOTSTRAP_ADMIN_USERNAME=your_sathi_username
